{
  "name": "testapp",
  "version": "1.0.0",
  "description": "My Electron Desktop App",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.yourname.myapp",
    "productName": "MyApp",
    "win": {
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "linux": {
      "target": "AppImage"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ]
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  }
}

